# StudyRoute environment template. Copy to .env and fill in what you need.
# Every value is optional in SANDBOX mode: the app generates throw-away dev
# secrets under ./data (gitignored) and runs in TEMPLATE MODE without an LLM key.
# Never commit a filled-in .env. Never put real IDs, passports or account numbers here.

# sandbox | production  (production refuses to start without the secrets below)
APP_ENV=

# SQLAlchemy URL. Empty means sqlite:///./data/studyroute.db
DATABASE_URL=

# Signing key for access tokens (PEM, EC P-256, newlines escaped as \n)
JWT_PRIVATE_KEY_PEM=
# AES-256-GCM key for encrypted columns, base64 of 32 random bytes
DATA_ENCRYPTION_KEY=
# One HMAC secret per provider adapter, plus an optional previous secret for rotation
WEBHOOK_SECRET_PROV_A=
WEBHOOK_SECRET_PROV_B=
WEBHOOK_SECRET_PROV_C=
WEBHOOK_SECRET_PROV_A_PREVIOUS=
WEBHOOK_SECRET_PROV_B_PREVIOUS=
WEBHOOK_SECRET_PROV_C_PREVIOUS=

# Fixed MFA code accepted in SANDBOX mode only (real TOTP also works). Empty uses the
# documented sandbox default. Ignored when APP_ENV=production.
SANDBOX_MFA_CODE=
# Set to false to stop /health and the sign-in page from showing the demo accounts and MFA hint.
SHOW_DEMO_HINTS=
# Password given to the seeded demo accounts. Empty uses the documented sandbox default.
SEED_DEMO_PASSWORD=

# Comma-separated list of exact browser origins allowed by CORS
CORS_ORIGINS=

# AI layer. Leave LLM_PROVIDER empty for TEMPLATE MODE (no network, no key). A person can still
# add their own Gemini or Groq key in the assistant settings; the server stores it encrypted.
# After filling these in, run `python -m app.scripts.check_ai` (from backend/): it must print OK.
# gemini | groq | anthropic | openai_compatible
LLM_PROVIDER=
LLM_API_KEY=
# Pin the exact model id you tested with. It is logged in every AI audit event.
LLM_MODEL=
# Only for openai_compatible providers
LLM_BASE_URL=

# The small trained reader that understands what a parent types. It runs locally on CPU.
# auto = use it when onnxruntime and the model file are present; off = fixed rules only.
NLU_MODE=

# The small policy, trained with reinforcement learning, that decides whether the assistant asks,
# confirms or plans. Needs the trained reader. auto = use it; off = plan as soon as the amount is known.
DIALOGUE_MODE=

# Cloud chat through YOUR Hugging Face Space. Default is off (template mode). Set true only after
# HF_SPACE_URL, HF_TOKEN and HF_SPACE_APP_SECRET are filled in and tested.
ASSISTANT_CLOUD_ENABLED=
# Your deployed ZeroGPU Space's direct HTTPS origin. No trailing API path.
HF_SPACE_URL=
# Server-only HF access token and shared secret; never put these in web/.env.
HF_TOKEN=
HF_SPACE_APP_SECRET=
HF_SPACE_MODEL=Qwen/Qwen3-4B-Instruct-2507
# Defaults are configurable because provider model availability can change.
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
CLOUD_TIMEOUT_SECONDS=90
