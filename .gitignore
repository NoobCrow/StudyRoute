# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
data/
dev_secrets.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Databases
*.db
*.db-wal
*.db-shm
