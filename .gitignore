# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build output and submission archive
/dist/
/submission/*.zip

# ML training workspace (checkpoints, caches and the CUDA environment stay local)
ml/.cache/
ml/.tmp/
ml/runs/
ml/explainer/runs/

# the training data and generator of the trained reader are part of the project (unlike runtime data/)
!ml/data/
ml/data/external/
