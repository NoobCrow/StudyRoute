# Copy variables into Botkeep Environment; never commit filled secrets.
APP_ENV=sandbox
PUBLIC_ORIGIN=https://YOUR-ACTUAL-HOSTNAME
CORS_ORIGINS=https://YOUR-ACTUAL-HOSTNAME
ASSISTANT_CLOUD_ENABLED=true
BOTKEEP_SEED_DEMO=true
SHOW_DEMO_HINTS=true

# Prefer the actual persistent path offered by Botkeep.
# Blank DATA_DIR uses the repository's data/ directory; verify it survives source updates.
DATA_DIR=
DATABASE_URL=
DATA_ENCRYPTION_KEY=

# Personal Gemini/Groq keys can be saved after login instead of a shared operator key.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
HF_SPACE_URL=
HF_TOKEN=
HF_SPACE_APP_SECRET=

# Use the assigned port from Network; do not guess a value here.
SERVER_PORT=
