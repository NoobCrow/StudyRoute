flowchart LR
  B["<b>Browser</b><br/>React + TypeScript<br/>strict CSP, no inline code"]
  N["<b>nginx</b><br/>serves the UI, proxies /api<br/>security headers"]
  A["<b>FastAPI</b><br/>auth, rate limits, validation,<br/>Idempotency-Key, RFC 7807 errors"]
  E["<b>Engine</b> (pure, no I/O)<br/>money, FX, fees, ranking,<br/>planner, interbank plans"]
  D["<b>Domain</b><br/>state machine, KYC, limits,<br/>RBAC, ledger, bank network"]
  AI["<b>AI layer</b><br/>policy check, masking,<br/>number guard, tool allow-list"]
  AU["<b>Audit</b><br/>append-only SHA-256<br/>hash chain + Verify"]
  P["<b>Simulated providers</b><br/>HMAC-signed webhooks"]
  DB[("SQLite<br/>Postgres optional")]
  LLM["Language model<br/>(optional: template mode<br/>needs no key)"]

  B -->|"same origin"| N --> A
  A --> E
  A --> D
  A --> AI
  A --> AU
  A --> P
  E --> DB
  D --> DB
  AU --> DB
  P -->|"signed status webhooks"| A
  AI -.->|"masked text only"| LLM

  classDef sandbox fill:#fff4cc,stroke:#c28b00,color:#3d2c00
  classDef core fill:#dff1ef,stroke:#0f766e,color:#0b3a36
  class P,LLM sandbox
  class E,D,AI,AU core
